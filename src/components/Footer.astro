<style>
  .footer {
    background: #002f4b;
    color: white;
    font-size: 14px;
    font-family: var(--font-secondary, sans-serif);
  }

  .footer-inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: 3rem 2rem 2rem;
  }

  /* Top row */
  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    margin-bottom: 2rem;
  }
  @media (max-width: 640px) {
    .footer-top { flex-direction: column; align-items: center; text-align: center; }
  }

  .footer-logo-link { display: inline-flex; flex-shrink: 0; }
  .footer-logo-link img { width: 140px; height: auto; }

  .footer-contact-row {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1rem;
  }
  @media (max-width: 640px) { .footer-contact-row { align-items: center; } }

  .footer-phones {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  @media (max-width: 640px) { .footer-phones { justify-content: center; } }

  .footer-phone-link {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: rgba(255,255,255,0.85);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    transition: color 0.15s;
  }
  .footer-phone-link:hover { color: white; }
  .footer-phone-link--wa { color: #4ade80; }
  .footer-phone-link--wa:hover { color: #86efac; }

  /* Social icons */
  .footer-social {
    display: flex;
    gap: 0.875rem;
    align-items: center;
  }
  .footer-social a {
    color: rgba(255,255,255,0.6);
    text-decoration: none;
    transition: color 0.15s;
    display: flex;
  }
  .footer-social a:hover { color: #00aaff; }

  .footer-social--desktop { display: flex; }
